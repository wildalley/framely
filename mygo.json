    "depends": ["libayatana-appindicator3-1", "xdg-desktop-portal", "libpipewire-0.3-0", "libva2", "libva-drm2"]
  },
  "macos": {
    "minimumSystemVersion": "15.0",
    "infoPlist": { "LSUIElement": true }
  }
}
