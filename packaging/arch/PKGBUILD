pkgname=screenpin
pkgver=0.2.0
pkgrel=1
pkgdesc="Non-destructive cross-platform screenshot editor"
arch=('x86_64' 'aarch64')
url="https://github.com/wildalley/screenpin"
license=('MIT')
depends=('gtk3' 'libayatana-appindicator' 'webkit2gtk-4.1' 'xdg-desktop-portal')
makedepends=('nodejs' 'npm' 'pkgconf' 'rust')
options=('!debug' '!lto')
source=()
sha256sums=()

_repo_root="$(realpath "$startdir/../..")"

build() {
  local _build_root="$srcdir/repo"

  mkdir -p "$srcdir" "$_build_root"
  tar \
    --exclude=node_modules \
    --exclude=dist \
    --exclude=src-tauri/target \
    --exclude=.git \
    --exclude=packaging/arch/pkg \
    --exclude=packaging/arch/src \
    --exclude='packaging/arch/*.pkg.tar.*' \
    -cf - -C "$_repo_root" . | tar -xf - -C "$_build_root"
  cd "$_build_root"
  npm ci --no-audit --no-fund
  npm run tauri -- build --no-bundle
}

package() {
  local _build_root="$srcdir/repo"

  install -Dm755 "$_build_root/src-tauri/target/release/screenpin" "$pkgdir/usr/bin/screenpin"
  install -Dm644 "$startdir/screenpin.desktop" "$pkgdir/usr/share/applications/screenpin.desktop"
  install -Dm644 "$_build_root/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/screenpin.png"
  install -Dm644 "$_build_root/src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/screenpin.png"
  install -Dm644 "$_build_root/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/screenpin.png"
  install -Dm644 "$_build_root/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/screenpin.png"
  install -Dm644 "$_build_root/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/screenpin.png"
  install -Dm644 "$_build_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_build_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
