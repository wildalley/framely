pkgname=framely
pkgver=0.4.0
pkgrel=1
pkgdesc="Framely (取景): screenshots, pins, scrolling capture, recording, offline OCR and translation (formerly ScreenPin)"
arch=('x86_64' 'aarch64')
url="https://github.com/wildalley/framely"
license=('MIT')
depends=('gtk3' 'libayatana-appindicator' 'xdg-desktop-portal' 'libpipewire' 'libva')
makedepends=('go>=1.27.3' 'uv' 'python' 'pkgconf' 'nasm')
provides=("screenpin=$pkgver" "screenpin-native=$pkgver")
conflicts=('screenpin' 'screenpin-native')
replaces=('screenpin-native')
options=('!debug' '!lto')
source=()
sha256sums=()

_repo_root="$(realpath "$startdir/../..")"

build() {
  local _build_root="$srcdir/repo"
  local _go_arch
  case "$CARCH" in
    x86_64) _go_arch=amd64 ;;
    aarch64) _go_arch=arm64 ;;
    *) return 1 ;;
  esac

  mkdir -p "$_build_root"
  # Copy the workspace without local credentials, agent state or build outputs.
  tar \
    --exclude=.git \
    --exclude=.aws \
    --exclude=.agents \
    --exclude=.codex \
    --exclude=.claude \
    --exclude=.scratch \
    --exclude=node_modules \
    --exclude=dist \
    --exclude=target \
    --exclude=build \
    --exclude='resources/*/workers' \
    --exclude='packaging/*/src' \
    --exclude='packaging/*/pkg' \
    --exclude='packaging/*/*.pkg.tar.*' \
    -cf - -C "$_repo_root" . | tar -xf - -C "$_build_root"
  cd "$_build_root"
  python scripts/build-components.py
  go tool mygo build -platform "linux/$_go_arch"
}

package() {
  local _build_root="$srcdir/repo"
  local _go_arch
  case "$CARCH" in
    x86_64) _go_arch=amd64 ;;
    aarch64) _go_arch=arm64 ;;
    *) return 1 ;;
  esac

  install -Dm755 "$_build_root/build/native/linux-$_go_arch/screenpin" "$pkgdir/usr/lib/screenpin/screenpin"
  cp -a "$_build_root/build/native/linux-$_go_arch/workers" "$pkgdir/usr/lib/screenpin/workers"
  install -dm755 "$pkgdir/usr/bin"
  ln -s ../lib/screenpin/screenpin "$pkgdir/usr/bin/screenpin"
  # Match the registered portal ID and preserve permissions from the Tauri app.
  install -Dm644 "$startdir/io.screenpin.desktop.desktop" "$pkgdir/usr/share/applications/io.screenpin.desktop.desktop"
  local _size
  for _size in 32 64 128 256 512; do
    install -Dm644 "$_build_root/assets/icons/${_size}x${_size}.png" "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/screenpin.png"
  done
  install -Dm644 "$_build_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_build_root/internal/ocrtext/LICENSE.jieba" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.jieba"
  install -Dm644 "$_build_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$_build_root/docs/NATIVE.md" "$pkgdir/usr/share/doc/$pkgname/NATIVE.md"
}
