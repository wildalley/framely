{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenPin",
  "version": "0.1.0",
  "identifier": "io.screenpin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenPin",
        "width": 460,
        "height": 300,
        "minWidth": 200,
        "minHeight": 120,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
