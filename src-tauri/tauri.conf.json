{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenPin",
  "version": "0.2.0",
  "identifier": "io.screenpin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "ScreenPin",
        "width": 460,
        "height": 300,
        "minWidth": 200,
        "minHeight": 120,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
